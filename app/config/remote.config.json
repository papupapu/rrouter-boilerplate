{
  "$schema": "./schemas/remote.schema.json",
  "description": "Configuration for remote config sources",
  "sources": {
    "categories": {
      "enabled": true,
      "method": "GET",
      "priority": "remote",
      "timeout": 15000,
      "fallbackToLocal": true,
      "transform": null
    }
  },
  "global": {
    "timeout": 10000,
    "retryOnFailure": true,
    "maxRetries": 2
  }
}
