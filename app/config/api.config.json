{
  "$schema": "./schemas/api.schema.json",
  "description": "API endpoints and configuration",
  "baseUrls": {
    "dummyJson": "https://dummyjson.com"
  },
  "endpoints": {
    "product": "/products/{slug}",
    "categories": "/products/categories",
    "productsByCategory": "/products/category/{slug}"
  },
  "timeouts": {
    "default": 10000,
    "categories": 15000
  },
  "retryPolicy": {
    "maxRetries": 3,
    "retryDelay": 1000
  }
}
